{
  "name": "WAV to MP3 Converter",
  "short_name": "WAV to MP3",
  "description": "Convert WAV, FLAC, M4A and OGG files to MP3 in your browser with chosen bitrate, no upload. Free and open source, nothing is uploaded, works offline.",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "background_color": "#f6f7fb",
